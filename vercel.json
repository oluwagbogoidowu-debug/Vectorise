{
  "functions": {
    "api/og.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sprint/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/sprint/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/sprints/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/sprints/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/sprint/preview/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/sprint/preview/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/onboarding/description/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/onboarding/description/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/onboarding/start-here/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/onboarding/start-here/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/join/:referralCode/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/join/:referralCode/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/challenge/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/challenge/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/track/:id",
      "destination": "/api/og?type=track&id=:id"
    },
    {
      "source": "/track/:id/",
      "destination": "/api/og?type=track&id=:id"
    },
    {
      "source": "/tracks/:id",
      "destination": "/api/og?type=track&id=:id"
    },
    {
      "source": "/tracks/:id/",
      "destination": "/api/og?type=track&id=:id"
    },
    {
      "source": "/track-starter/:id",
      "destination": "/api/og?type=track&id=:id"
    },
    {
      "source": "/track-starter/:id/",
      "destination": "/api/og?type=track&id=:id"
    },
    {
      "source": "/onboarding/track-starter/:id",
      "destination": "/api/og?type=track&id=:id"
    },
    {
      "source": "/onboarding/track-starter/:id/",
      "destination": "/api/og?type=track&id=:id"
    },
    {
      "source": "/track-start-here/:trackId/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/track-start-here/:trackId/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/onboarding/track-start-here/:trackId/:id",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/onboarding/track-start-here/:trackId/:id/",
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "sprintId",
          "value": "(?<sprintId>.+)"
        }
      ],
      "destination": "/api/og?type=sprint&id=:sprintId"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "sprint",
          "value": "(?<sprintId>.+)"
        }
      ],
      "destination": "/api/og?type=sprint&id=:sprintId"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "trackId",
          "value": "(?<trackId>.+)"
        }
      ],
      "destination": "/api/og?type=track&id=:trackId"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "track",
          "value": "(?<trackId>.+)"
        }
      ],
      "destination": "/api/og?type=track&id=:trackId"
    },
    { "source": "/og", "destination": "/api/og" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
