{
  "rewrites": [
    {
      "source": "/sprint/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|whatsapp|slackbot|twitterbot|linkedinbot|telegrambot|discordbot|pinterest).*"
        }
      ],
      "destination": "/api/og?type=sprint&id=:id"
    },
    {
      "source": "/track/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|whatsapp|slackbot|twitterbot|linkedinbot|telegrambot|discordbot|pinterest).*"
        }
      ],
      "destination": "/api/og?type=track&id=:id"
    },
    { "source": "/og", "destination": "/api/og" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
