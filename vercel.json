          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebot|whatsapp|slackbot|twitterbot|linkedinbot|telegrambot|discordbot|pinterest|applebot|embedly|vkshare).*"
        }
      ],
      "destination": "/api/og?type=track&id=:id"
